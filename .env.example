PORT=4027

# Base única local (operativa + reportes / dimensiones)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=clinica-bd

# Deja que TypeORM cree/actualice el esquema solo. Útil en desarrollo
# (`npm run seed` lo necesita). En producción tiene que ser false: por defecto
# se apaga cuando NODE_ENV=production.
DB_SYNCHRONIZE=true

# OBLIGATORIO. Con este secreto se firman y validan los JWT: si alguien lo
# conoce puede forjar un token con rol admin. Generá uno propio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si falta, en producción el arranque falla a propósito.
JWT_SECRET=cambiar_en_local
JWT_EXPIRES_IN=24h

# Lista blanca de orígenes para CORS, separados por coma
# (ej. https://panel.midominio.com,https://otro.com).
# Vacío = se refleja cualquier origen, aceptable solo en desarrollo.
# La app Flutter no manda header Origin, así que esto solo afecta clientes web.
CORS_ORIGINS=

# OpenRouter: es el proveedor del asistente de prescripción.
# Vacío = el endpoint responde 503 y la app muestra una vista previa.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=512
OPENROUTER_CACHE_TTL_SECONDS=90
