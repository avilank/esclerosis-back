PORT=3000

# Base principal (login / historias clínicas)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=esclerosis_db

JWT_SECRET=cambiar_en_local
JWT_EXPIRES_IN=24h

# Segunda DB (analytics). Debe existir aunque no la uses aún.
ESCLEROSISD_DB_HOST=localhost
ESCLEROSISD_DB_PORT=5432
ESCLEROSISD_DB_USERNAME=postgres
ESCLEROSISD_DB_PASSWORD=postgres
ESCLEROSISD_DB_NAME=esclerosisd

# OpenRouter (opcional). Vacío = la app muestra vista previa.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=512
OPENROUTER_CACHE_TTL_SECONDS=90
